#
# Read configuration. Never return secrets: readers can run this action.
#

import os
import sys
import json

config = {}

# Read current configuration from the environment file
config["host"] = os.getenv("TRAEFIK_HOST", "")
config["http2https"] = os.getenv("TRAEFIK_HTTP2HTTPS", "True").lower() == "true"
config["lets_encrypt"] = os.getenv("TRAEFIK_LETS_ENCRYPT", "False").lower() == "true"
config["ssh_host_key_checking"] = os.getenv("SSH_HOST_KEY_CHECKING", "warn")
if config["ssh_host_key_checking"] not in ("warn", "enforce", "off"):
    config["ssh_host_key_checking"] = "warn"

json.dump(config, fp=sys.stdout)
