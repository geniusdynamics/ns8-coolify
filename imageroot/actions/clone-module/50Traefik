import agent
import agent.tasks
import os

configure_retval = agent.tasks.run(agent_id=os.environ['AGENT_ID'], action='configure-module', data={
    # Never request a certificate on clone: the DNS may not point to this
    # node yet. The admin enables Let's Encrypt again when it does.
    "lets_encrypt": False,
    "host": os.environ["TRAEFIK_HOST"],
    "http2https": os.environ.get("TRAEFIK_HTTP2HTTPS", "True").lower() == "true",
    "ssh_host_key_checking": os.environ.get("SSH_HOST_KEY_CHECKING", "warn"),
})
agent.assert_exp(configure_retval['exit_code'] == 0, "The configure-module subtask failed!")
