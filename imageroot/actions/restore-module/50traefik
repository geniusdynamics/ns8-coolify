import sys
import json
import agent
import agent.tasks
import os

request = json.load(sys.stdin)
renv = request['environment']

configure_retval = agent.tasks.run(agent_id=os.environ['AGENT_ID'], action='configure-module', data={
    # Never request a certificate on restore: the DNS may not point to
    # this node yet. The admin enables Let's Encrypt again when it does.
    "lets_encrypt": False,
    "host": renv["TRAEFIK_HOST"],
    "http2https": renv.get("TRAEFIK_HTTP2HTTPS", "True").lower() == "true",
    "ssh_host_key_checking": renv.get("SSH_HOST_KEY_CHECKING", "warn"),
})
agent.assert_exp(configure_retval['exit_code'] == 0, "The configure-module subtask failed!")
