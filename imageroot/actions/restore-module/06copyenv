import sys
import json
import agent

request = json.load(sys.stdin)

original_environment = request['environment']

# Backups of older module releases may lack some variables
for evar in [
        "TRAEFIK_HOST",
        "TRAEFIK_HTTP2HTTPS",
        "TRAEFIK_LETS_ENCRYPT",
        "SSH_HOST_KEY_CHECKING",
    ]:
    if evar in original_environment:
        agent.set_env(evar, original_environment[evar])

agent.dump_env()
