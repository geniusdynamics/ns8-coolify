#
# Store the Coolify settings that are not secrets. The env files of the
# containers are written by 30write_env_files.
#

import json
import os
import sys

import agent

data = json.load(sys.stdin)

# SSH host key checking of Coolify 4.7+: warn (default), enforce or off.
# A request without the field keeps the current value.
agent.set_env(
    "SSH_HOST_KEY_CHECKING",
    data.get("ssh_host_key_checking", os.environ.get("SSH_HOST_KEY_CHECKING", "warn")),
)
