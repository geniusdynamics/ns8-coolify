[Unit]
Description=Podman  redis-app.service
BindsTo=coolify.service
After=coolify.service
Before=coolify-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
EnvironmentFile=-%S/state/smarthost.env
WorkingDirectory=%S/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/mkdir -p tmp
ExecStartPre=/bin/rm -f %t/redis-app.pid %t/redis-app.ctr-id
ExecStartPre=-runagent discover-smarthost
ExecStart=/usr/bin/podman run --conmon-pidfile %t/redis-app.pid  --cidfile %t/redis-app.ctr-id --cgroups=no-conmon  --pod-id-file %t/coolify.pod-id --replace -d --name  redis-app  \
  --env-file redis.env \
  --volume redis-data:/data:Z \
  ${REDIS_IMAGE} \
  sh -c 'echo "requirepass $${REDIS_PASSWORD}" | exec docker-entrypoint.sh redis-server - --save 20 1 --loglevel warning'
# The password comes from redis.env and reaches redis-server on stdin, as
# configuration: it never shows in a process command line
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/redis-app.ctr-id -t 10
ExecReload=/usr/bin/podman kill -s HUP redis-app
SyslogIdentifier=%u
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/redis-app.ctr-id
PIDFile=%t/redis-app.pid
Type=forking

[Install]
WantedBy=default.target
