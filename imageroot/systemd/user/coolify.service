#
# This systemd unit starts a coolify instance using Podman.
# Most parts of this file come from podman-generate-systemd.
#

[Unit]
Description=Podman coolify.service
Requires=postgres-app.service redis-app.service coolify-app.service
Before=postgres-app.service redis-app.service coolify-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=-%S/state/environment
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/coolify.pid %t/coolify.pod-id
# Port 8080: dashboard (its nginx also proxies the /app/ and /terminal/ws
# WebSockets), 6001: realtime (Reverb), 6002: terminal. Coolify 4.4+ serves
# all three from the coolify-app container.
ExecStartPre=/usr/bin/podman pod create --infra-conmon-pidfile %t/coolify.pid  --pod-id-file %t/coolify.pod-id  --name coolify  --publish 127.0.0.1:${CLIENT_TCP_PORT}:8080 --publish 127.0.0.1:${SOCKET_TCP_PORT}:6001 --publish 127.0.0.1:${WEBSOCKET_TCP_PORT}:6002  --replace
ExecStart=/usr/bin/podman pod start --pod-id-file %t/coolify.pod-id
ExecStop=/usr/bin/podman pod stop --ignore --pod-id-file %t/coolify.pod-id -t 10
ExecStopPost=/usr/bin/podman pod rm --ignore -f --pod-id-file %t/coolify.pod-id
PIDFile=%t/coolify.pid
Type=forking

[Install]
WantedBy=default.target
